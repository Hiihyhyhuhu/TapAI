# ============================================
# TAP AI Backend — Environment Variables
# ============================================

# --- Search & RAG Engine ---
GEMINI_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Database ---
DATABASE_URL=sqlite:///./tapai_affiliate.db

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OTP ---
OTP_EXPIRE_MINUTES=5

# --- Admin (MVP: simple secret key) ---
ADMIN_SECRET_KEY=admin-secret-change-this

# --- SMTP Email (MVP: OTP is printed to console) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# --- Cloudflare Turnstile CAPTCHA (MVP: skipped) ---
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Vector DB Qdrant (cache DINOv2 Re-ID)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ranking Mode: Pure Similarity (Tối ưu hóa 100% trả về sản phẩm khớp nhất)

# API Keys for SAM3
HF_TOKEN=your_huggingface_token_here

# Checkpoint Student YOLO (Open-Vocabulary hoặc YOLO-Seg)
STUDENT_CHECKPOINT=yolov8s-world.pt

# Repositories of Meta SAM 3 / HuggingFace
SAM3_MODEL_REPO=facebook/sam3
SAM3_FALLBACK_REPO=jetjodh/sam3

# Cấu hình thiết bị & VRAM (auto: tự động nạp SAM 3 nếu VRAM >= 6GB, dưới 6GB tự dùng Student YOLO trên GPU)
ENABLE_SAM3_TEACHER=auto
DEVICE=auto

OUTPUT_CROPS_DIR=outputs/sam_crops

OUTPUT_CROPS_DIR=outputs/sam_crops

RAG_API_URL=http://localhost:8000/api/v1/match-item
