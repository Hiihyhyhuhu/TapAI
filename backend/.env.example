# ============================================
# TAP AI Backend — Environment Variables
# ============================================

# --- Search & RAG Engine (hiện có) ---
GEMINI_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# --- Database ---
DATABASE_URL=sqlite:///./tapai_affiliate.db

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OTP ---
OTP_EXPIRE_MINUTES=5

# --- Admin (MVP: simple secret key) ---
ADMIN_SECRET_KEY=admin-secret-change-this

# --- SMTP Email (MVP: OTP is printed to console) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# --- Cloudflare Turnstile CAPTCHA (MVP: skipped) ---
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Vector DB Qdrant (cache DINOv2 Re-ID)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Shopping Season (DEFAULT, MEGA_SALE, TET_HOLIDAY)
# FORCE_SEASON=MEGA_SALE

# API Keys for SAM3
HF_TOKEN=your_huggingface_token_here

# checkpoint Student YOLO-Seg
STUDENT_CHECKPOINT=yolov8n-seg.pt

# Repositories of Meta SAM 3/HuggingFace
SAM3_MODEL_REPO=facebook/sam3
SAM3_FALLBACK_REPO=jetjodh/sam3

DEVICE=auto

OUTPUT_CROPS_DIR=outputs/sam_crops

RAG_API_URL=http://localhost:8000/api/v1/match-item
