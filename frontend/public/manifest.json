{
  "manifest_version": 3,
  "name": "TAP AI - Shoppable Media",
  "version": "1.0.0",
  "description": "Tap anything, buy anywhere",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Mở TAP AI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
